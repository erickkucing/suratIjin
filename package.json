{
  "name": "surat-ijin-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && (systemctl restart surat-ijin 2>/dev/null || true)",
    "postbuild": "systemctl restart surat-ijin 2>/dev/null || true",
    "start": "next start",
    "restart": "systemctl restart surat-ijin",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "db:provision": "node scripts/provision-db.mjs",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx src/db/seed-legacy.ts",
    "db:migrate-remote": "tsx scripts/migrate-remote.ts",
    "db:migrate-slugs": "tsx scripts/migrate-random-slugs.ts",
    "storage:clean": "tsx scripts/cleanup-orphaned-uploads.ts",
    "setup:https": "scripts/setup-https.sh",
    "setup:tunnel": "scripts/setup-cloudflare-tunnel.sh",
    "test:unit": "vitest run",
    "test:ocr": "services/ocr-service/venv/bin/python services/ocr-service/test_letter_parser.py 2>/dev/null || python3 services/ocr-service/test_letter_parser.py",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.4.8",
    "drizzle-orm": "^0.38.4",
    "exceljs": "^4.4.0",
    "heic-to": "^1.3.1",
    "ioredis": "^6.0.0",
    "jose": "^5.9.6",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.475.0",
    "mysql2": "^3.12.0",
    "next": "^15.1.7",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.7",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.6"
  }
}

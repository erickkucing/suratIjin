# ==============================================================================
# Surat Ijin Next.js - Konfigurasi Lingkungan (.env.example)
# ==============================================================================

# Koneksi Database MySQL (format: mysql://USER:PASSWORD@HOST:PORT/DATABASE)
DATABASE_URL="mysql://surat_user:surat_pass_2026@127.0.0.1:3306/db_suratizin"

# JWT Secret Key (Kunci enkripsi session cookie, minimal 32 karakter acak)
JWT_SECRET="ganti_dengan_random_secret_string_minimal_32_karakter_aman_2026"

# Direktori Penyimpanan Arsip Surat (Relatif atau Absolut)
STORAGE_PATH="./storage/uploads"

# Base URL Aplikasi (Gunakan port 3000 untuk dev, atau domain/IP publik untuk production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
